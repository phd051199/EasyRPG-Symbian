TARGET            EasyRPG.exe
TARGETTYPE        exe
UID               0x100039CE 0xE31EA5A1

EPOCHEAPSIZE      0x40000 0x00800000
EPOCSTACKSIZE     0x10000
OPTION GCCE       -O3 -fomit-frame-pointer -fno-rtti
MACRO             EASYRPG_LAUNCHER_PROCESS

SOURCEPATH        ..\src\platform\symbian
SOURCE            Main.cpp
SOURCE            Application.cpp
SOURCE            Document.cpp
SOURCE            AppUi.cpp
SOURCE            LauncherView.cpp
SOURCE            GameLocator.cpp
SOURCE            GameMetadata.cpp
SOURCE            ZipVfs.cpp
SOURCE            Encoding.cpp

SOURCEPATH        ..\platform\symbian\resources

START RESOURCE    Resources.rss
HEADER
TARGET            EasyRPG
TARGETPATH        resource\apps
END

START RESOURCE    Registration.rss
TARGET            EasyRPG_reg
TARGETPATH        \private\10003a3f\apps
END

USERINCLUDE       ..\inc
USERINCLUDE       ..\platform\symbian\resources
SYSTEMINCLUDE     \epoc32\include
SYSTEMINCLUDE     \epoc32\include\stdapis
SYSTEMINCLUDE     \epoc32\include\libc

LIBRARY           euser.lib
LIBRARY           apparc.lib
LIBRARY           apgrfx.lib
LIBRARY           cone.lib
LIBRARY           eikcore.lib
LIBRARY           eikcoctl.lib
LIBRARY           eikctl.lib
LIBRARY           avkon.lib
LIBRARY           bafl.lib
LIBRARY           efsrv.lib
LIBRARY           charconv.lib
LIBRARY           form.lib

LANG              SC

VENDORID          0
SECUREID          0xE31EA5A1
CAPABILITY        None

#ifdef ENABLE_ABIV2_MODE
DEBUGGABLE_UDEBONLY
#endif
