TARGET            EasyRPGGame.exe
TARGETTYPE        exe
UID               0x100039CE 0xE31EA5A2

EPOCHEAPSIZE      0x100000 0x2000000
EPOCSTACKSIZE     0x10000
OPTION GCCE       -O3 -fomit-frame-pointer -fno-rtti

SOURCEPATH        ..\src\platform\symbian
SOURCE            RuntimeMain.cpp
SOURCE            RuntimeEngine.cpp
SOURCE            FrameTimer.cpp
SOURCE            DisplaySurface.cpp
SOURCE            PerfOverlay.cpp
SOURCE            AudioMixer.cpp
SOURCE            AudioBridge.cpp
SOURCE            MovieBridge.cpp
SOURCE            ZipVfs.cpp
SOURCE            LcfProbe.cpp
SOURCE            Encoding.cpp
SOURCE            Dirent.cpp
SOURCE            PlayerRuntime.cpp

USERINCLUDE       ..\inc
SYSTEMINCLUDE     \epoc32\include
SYSTEMINCLUDE     \epoc32\include\stdapis
SYSTEMINCLUDE     \epoc32\include\libc

LIBRARY           euser.lib
LIBRARY           apparc.lib
LIBRARY           apgrfx.lib
LIBRARY           fbscli.lib
LIBRARY           bitgdi.lib
LIBRARY           gdi.lib
LIBRARY           hal.lib
LIBRARY           efsrv.lib
LIBRARY           bafl.lib
LIBRARY           libc.lib
LIBRARY           libm.lib
LIBRARY           libz.lib
LIBRARY           mediaclientaudio.lib
LIBRARY           mediaclientaudiostream.lib
LIBRARY           mediaclientvideo.lib
LIBRARY           ws32.lib
STATICLIBRARY     EasyRpgModernCore.lib

LANG              SC

VENDORID          0
SECUREID          0xE31EA5A2
CAPABILITY        None

#ifdef ENABLE_ABIV2_MODE
DEBUGGABLE_UDEBONLY
#endif
