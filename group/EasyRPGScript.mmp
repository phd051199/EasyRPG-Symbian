TARGET            EasyRPGScript.exe
TARGETTYPE        exe
UID               0x100039CE 0xE31EA5A3

EPOCHEAPSIZE      0x100000 0x03800000
EPOCSTACKSIZE     0x18000
OPTION GCCE       -O2 -fomit-frame-pointer -fno-rtti -mtune=arm1136jf-s
MACRO             EASYRPG_SCRIPT_PROCESS

SOURCEPATH        ..\src\platform\symbian
SOURCE            ScriptRuntimeMain.cpp
SOURCE            RgssEngine.cpp
SOURCE            RgssHostSymbian.cpp
SOURCE            AudioMixer.cpp
SOURCE            AudioBridge.cpp
SOURCE            ZipVfs.cpp
SOURCE            Encoding.cpp
SOURCE            Dirent.cpp

SOURCEPATH        ..\src\script
SOURCE            Ruby3Platform.cpp

USERINCLUDE       ..\inc
USERINCLUDE       ..\src
USERINCLUDE       ..\src\script\ruby3
USERINCLUDE       ..\build\work\third-party\ruby-3.0.7
USERINCLUDE       ..\build\work\third-party\ruby-3.0.7\include
USERINCLUDE       ..\build\work\third-party\ruby-3.0.7\include\ruby
SYSTEMINCLUDE     \epoc32\include
SYSTEMINCLUDE     \epoc32\include\stdapis
SYSTEMINCLUDE     \epoc32\include\libc

LIBRARY           euser.lib
LIBRARY           apparc.lib
LIBRARY           apgrfx.lib
LIBRARY           fbscli.lib
LIBRARY           bitgdi.lib
LIBRARY           gdi.lib
LIBRARY           hal.lib
LIBRARY           efsrv.lib
LIBRARY           bafl.lib
LIBRARY           charconv.lib
LIBRARY           libc.lib
LIBRARY           libm.lib
LIBRARY           libz.lib
LIBRARY           libpthread.lib
LIBRARY           mediaclientaudio.lib
LIBRARY           mediaclientaudiostream.lib
LIBRARY           ws32.lib
STATICLIBRARY     EasyRpgRgss.lib
STATICLIBRARY     EasyRpgRgssSupport.lib
STATICLIBRARY     EasyRpgRuby3.lib

LANG              SC

VENDORID          0
SECUREID          0xE31EA5A3
CAPABILITY        None

#ifdef ENABLE_ABIV2_MODE
DEBUGGABLE_UDEBONLY
#endif
