+void Scene_Battle::AssignAutoBattleAction(Game_Actor* actor) {
+	if (!actor)
+		return;
+
+	std::vector<Game_Battler*> allies;
+	Main_Data::game_party->GetBattlers(allies);
+	Game_Battler* weakest = NULL;
+	Game_Battler* dead = NULL;
+	int weakest_missing = 0;
+	int weakest_max = 1;
+	int total_missing = 0;
+	int total_max = 0;
+
+	for (std::vector<Game_Battler*>::const_iterator it = allies.begin(); it != allies.end(); ++it) {
+		Game_Battler* battler = *it;
+		if (battler->IsDead()) {
+			if (!dead)
+				dead = battler;
+			continue;
+		}
+		const int max_hp = std::max(1, battler->GetMaxHp());
+		const int missing = std::max(0, max_hp - battler->GetHp());
+		total_missing += missing;
+		total_max += max_hp;
+		if (!weakest || static_cast<long long>(missing) * weakest_max > static_cast<long long>(weakest_missing) * max_hp) {
+			weakest = battler;
+			weakest_missing = missing;
+			weakest_max = max_hp;
+		}
+	}
+
+	const RPG::Skill* best_heal = NULL;
+	Game_Battler* best_heal_target = NULL;
+	int best_heal_score = 0;
+	const RPG::Skill* best_attack = NULL;
+	int best_attack_score = 0;
+	const std::vector<int16_t>& skills = actor->GetSkills();
+	std::vector<Game_Battler*> enemies;
+	Main_Data::game_enemyparty->GetActiveBattlers(enemies);
+	const int enemy_count = static_cast<int>(enemies.size());
+
+	for (std::vector<int16_t>::const_iterator it = skills.begin(); it != skills.end(); ++it) {
+		const int skill_id = *it;
+		if (skill_id <= 0 || skill_id > static_cast<int>(Data::skills.size()) || !actor->IsSkillUsable(skill_id))
+			continue;
+		const RPG::Skill& skill = Data::skills[skill_id - 1];
+		if (skill.type != RPG::Skill::Type_normal && skill.type < RPG::Skill::Type_subskill)
+			continue;
+
+		const bool healing_scope = skill.scope == RPG::Skill::Scope_self ||
+			skill.scope == RPG::Skill::Scope_ally || skill.scope == RPG::Skill::Scope_party;
+		if (healing_scope) {
+			const bool revives = !skill.state_effects.empty() && skill.state_effects[0];
+			Game_Battler* target = NULL;
+			int score = 0;
+			if (skill.scope == RPG::Skill::Scope_self) {
+				const int max_hp = std::max(1, actor->GetMaxHp());
+				const int missing = std::max(0, max_hp - actor->GetHp());
+				if (skill.affect_hp && missing * 100 >= max_hp * 35) {
+					target = actor;
+					score = missing + skill.power;
+				}
+			} else if (skill.scope == RPG::Skill::Scope_ally) {
+				if (revives && dead) {
+					target = dead;
+					score = 0x3fffffff;
+				} else if (skill.affect_hp && weakest && weakest_missing * 100 >= weakest_max * 35) {
+					target = weakest;
+					score = weakest_missing + skill.power;
+				}
+			} else {
+				if (revives && dead) {
+					score = 0x3fffffff;
+				} else if (skill.affect_hp && total_max > 0 && total_missing * 100 >= total_max * 25) {
+					score = total_missing + skill.power * std::max(1, static_cast<int>(allies.size()));
+				}
+			}
+			if (score > best_heal_score) {
+				best_heal = &skill;
+				best_heal_target = target;
+				best_heal_score = score;
+			}
+			continue;
+		}
+
+		if ((skill.scope == RPG::Skill::Scope_enemy || skill.scope == RPG::Skill::Scope_enemies) && skill.affect_hp) {
+			int score = skill.power + actor->GetAtk() * skill.physical_rate / 20 + actor->GetSpi() * skill.magical_rate / 40;
+			score = score * std::max(1, skill.hit) / 100;
+			if (skill.scope == RPG::Skill::Scope_enemies)
+				score *= std::max(1, enemy_count);
+			if (score > best_attack_score) {
+				best_attack = &skill;
+				best_attack_score = score;
+			}
+		}
+	}
+
+	if (best_heal) {
+		if (best_heal->scope == RPG::Skill::Scope_party)
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, Main_Data::game_party.get(), *best_heal));
+		else
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, best_heal_target ? best_heal_target : actor, *best_heal));
+		return;
+	}
+
+	if (best_attack) {
+		if (best_attack->scope == RPG::Skill::Scope_enemies)
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, Main_Data::game_enemyparty.get(), *best_attack));
+		else
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, Main_Data::game_enemyparty->GetRandomActiveBattler(), *best_attack));
+		return;
+	}
+
+	Game_Battler* target = Main_Data::game_enemyparty->GetRandomActiveBattler();
+	if (target)
+		actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Normal>(actor, target));
+	else
+		actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::NoMove>(actor));
+}
