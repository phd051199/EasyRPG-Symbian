@@ -24,16 +26,21 @@ LcfWriter::~LcfWriter() {
 	Close();
 }
 
-void LcfWriter::Close() {
-	if (stream != NULL)
-		fclose(stream);
+bool LcfWriter::Close() {
+	if (stream == NULL)
+		return !write_error;
+
+	if (fflush(stream) != 0)
+		write_error = true;
+	if (fclose(stream) != 0)
+		write_error = true;
 	stream = NULL;
+	return !write_error;
 }
 
 void LcfWriter::Write(const void *ptr, size_t size, size_t nmemb) {
-#ifdef NDEBUG
-	fwrite(ptr, size, nmemb, stream);
-#else
-	assert(fwrite(ptr, size, nmemb, stream) == nmemb);
-#endif
+	if (write_error || stream == NULL || size == 0 || nmemb == 0)
+		return;
+	if (fwrite(ptr, size, nmemb, stream) != nmemb)
+		write_error = true;
 }
