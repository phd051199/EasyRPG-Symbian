+void Game_Interpreter::SanitizeEventCommands(std::vector<RPG::EventCommand>& commands) {
+	for (std::vector<RPG::EventCommand>::iterator it = commands.begin(); it != commands.end(); ++it) {
+		const size_t minimum = MinimumEventCommandParameters(it->code);
+		if (it->parameters.size() < minimum)
+			it->parameters.resize(minimum, 0);
+	}
+}
