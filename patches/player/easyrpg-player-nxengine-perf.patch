+int Cache::TrimUnusedIdle(int pressure) {
+	if (pressure < 0)
+		pressure = 0;
+	else if (pressure > 2)
+		pressure = 2;
+	const uint32_t cur_ticks = DisplayUi->GetTicks();
+	const size_t release_budget = pressure >= 2 ? 4 : (pressure > 0 ? 2 : 1);
+	const size_t inspect_budget = pressure >= 2 ? 24 : (pressure > 0 ? 12 : 4);
+	int freed_bytes = 0;
+	SweepBitmaps(cur_ticks, pressure, release_budget, inspect_budget, freed_bytes);
+	SweepExpiredTiles(pressure >= 2 ? 32 : (pressure > 0 ? 16 : 8));
+	return freed_bytes;
+}
 
