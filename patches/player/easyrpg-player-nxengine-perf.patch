+int SymbianWaveOffset(int aDepth, int aPhaseQ16) {
+	const unsigned int index = (static_cast<unsigned int>(aPhaseQ16) >> 16) & 0xffu;
+	return (2 * aDepth * static_cast<int>(KSymbianSinQ15[index])) / 32767;
+}
+
+uint16_t SymbianBlend565(uint16_t aSource, uint16_t aDestination, int aAlpha) {
+	if (aAlpha >= 255)
+		return aSource;
+	if (aAlpha <= 0)
+		return aDestination;
+	const int inverse = 255 - aAlpha;
+	const int source_r = (aSource >> 11) & 31;
+	const int source_g = (aSource >> 5) & 63;
+	const int source_b = aSource & 31;
+	const int destination_r = (aDestination >> 11) & 31;
+	const int destination_g = (aDestination >> 5) & 63;
+	const int destination_b = aDestination & 31;
+	const int red = (source_r * aAlpha + destination_r * inverse + 127) / 255;
+	const int green = (source_g * aAlpha + destination_g * inverse + 127) / 255;
+	const int blue = (source_b * aAlpha + destination_b * inverse + 127) / 255;
+	return static_cast<uint16_t>((red << 11) | (green << 5) | blue);
+}
+
+bool SymbianWaverBlit565(Bitmap& aDestination, int aX, int aY,
+	Bitmap const& aSource, Rect const& aSourceRect, int aDepth,
+	double aPhase, Opacity const& aOpacity) {
+	if (&aDestination == &aSource || aDestination.bpp() != 2 || aSource.bpp() != 2 ||
+		aDestination.GetTransparent() || aSource.GetTransparent() || aOpacity.IsSplit() ||
+		aSourceRect.y != 0 || aSourceRect.x < 0 || aSourceRect.width <= 0 || aSourceRect.height <= 0 ||
+		aSourceRect.x + aSourceRect.width > aSource.GetWidth() || aSourceRect.height > aSource.GetHeight())
+		return false;
+
+	const Rect* paint_clip = SymbianRenderDamage::PaintClipRect();
+	const int destination_width = aDestination.GetWidth();
+	const int destination_height = aDestination.GetHeight();
+	const int alpha = aOpacity.top;
+	const int phase_q16 = static_cast<int>(aPhase * (256.0 * 65536.0 / 360.0));
+	const int row_phase_step_q16 = 521958;
+	const uint8_t* source_base = static_cast<const uint8_t*>(aSource.pixels());
+	uint8_t* destination_base = static_cast<uint8_t*>(aDestination.pixels());
+	bool wrote = false;
+
+	for (int row = 0; row < aSourceRect.height; ++row) {
+		const int destination_y = aY + row;
+		if (destination_y < 0)
+			continue;
+		if (destination_y >= destination_height)
+			break;
+		if (paint_clip && (destination_y < paint_clip->y || destination_y >= paint_clip->y + paint_clip->height))
+			continue;
+
+		const int offset = SymbianWaveOffset(aDepth,
+			phase_q16 + (aSourceRect.y + row) * row_phase_step_q16);
+		int destination_x = aX + offset;
+		int source_x = aSourceRect.x;
+		int count = aSourceRect.width;
+		if (destination_x < 0) {
+			source_x -= destination_x;
+			count += destination_x;
+			destination_x = 0;
+		}
+		if (destination_x + count > destination_width)
+			count = destination_width - destination_x;
+		if (paint_clip) {
+			const int left = std::max(destination_x, paint_clip->x);
+			const int right = std::min(destination_x + count, paint_clip->x + paint_clip->width);
+			source_x += left - destination_x;
+			destination_x = left;
+			count = right - left;
+		}
+		if (count <= 0)
+			continue;
+
+		const uint16_t* source = reinterpret_cast<const uint16_t*>(
+			source_base + row * aSource.pitch()) + source_x;
+		uint16_t* destination = reinterpret_cast<uint16_t*>(
+			destination_base + destination_y * aDestination.pitch()) + destination_x;
+		if (alpha >= 255) {
+			std::memcpy(destination, source, static_cast<size_t>(count) * 2u);
+		} else if (alpha > 0) {
+			for (int column = 0; column < count; ++column)
+				destination[column] = SymbianBlend565(source[column], destination[column], alpha);
+		}
+		wrote = true;
+	}
+
+	if (wrote)
+		aDestination.Touch(aDestination.GetRect());
+	return true;
+}
 
