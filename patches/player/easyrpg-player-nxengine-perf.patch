+			size_t index = static_cast<size_t>(found - drawables.begin());
+			while (index > 0 && drawables[index - 1]->GetZ() > drawable->GetZ()) {
+				std::swap(drawables[index - 1], drawables[index]);
+				--index;
+			}
+			while (index + 1 < drawables.size() && drawables[index + 1]->GetZ() < drawable->GetZ()) {
+				std::swap(drawables[index], drawables[index + 1]);
+				++index;
+			}
+			return;
+		}
+	}
+#endif
+	if (target)
+		target->zlist_dirty = true;
 }
