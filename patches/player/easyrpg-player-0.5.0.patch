+void Scene_Battle::AssignAutoBattleAction(Game_Actor* actor) {
+	if (!actor)
+		return;
+
+	std::vector<Game_Battler*> allies;
+	Main_Data::game_party->GetBattlers(allies);
+	Game_Battler* dead = NULL;
+	Game_Battler* weakest = NULL;
+	int weakest_ratio = 100;
+	for (Game_Battler* battler : allies) {
+		if (battler->IsDead()) {
+			if (!dead)
+				dead = battler;
+			continue;
+		}
+		const int max_hp = std::max(1, battler->GetMaxHp());
+		const int ratio = battler->GetHp() * 100 / max_hp;
+		if (ratio < weakest_ratio) {
+			weakest = battler;
+			weakest_ratio = ratio;
+		}
+	}
+
+	const RPG::Skill* heal = NULL;
+	Game_Battler* heal_target = NULL;
+	const RPG::Skill* attack = NULL;
+	int attack_score = 0;
+	for (int skill_id : actor->GetSkills()) {
+		if (skill_id <= 0 || skill_id > static_cast<int>(Data::skills.size()) || !actor->IsSkillUsable(skill_id))
+			continue;
+		const RPG::Skill& skill = Data::skills[skill_id - 1];
+		if (skill.type != RPG::Skill::Type_normal && skill.type < RPG::Skill::Type_subskill)
+			continue;
+		const bool healing = skill.scope == RPG::Skill::Scope_ally || skill.scope == RPG::Skill::Scope_party;
+		if (healing) {
+			if (!heal && skill.affect_hp) {
+				if (dead && skill.scope == RPG::Skill::Scope_ally &&
+					!skill.state_effects.empty() && skill.state_effects[0]) {
+					heal = &skill;
+					heal_target = dead;
+				} else if (weakest && weakest_ratio < 65) {
+					heal = &skill;
+					heal_target = weakest;
+				}
+			}
+			continue;
+		}
+		if ((skill.scope == RPG::Skill::Scope_enemy || skill.scope == RPG::Skill::Scope_enemies) && skill.affect_hp) {
+			const int score = skill.power + actor->GetAtk() * skill.physical_rate / 20 + actor->GetSpi() * skill.magical_rate / 40;
+			if (score > attack_score) {
+				attack = &skill;
+				attack_score = score;
+			}
+		}
+	}
+
+	if (heal) {
+		if (heal->scope == RPG::Skill::Scope_party)
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, Main_Data::game_party.get(), *heal));
+		else
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, heal_target, *heal));
+		return;
+	}
+
+	if (attack) {
+		if (attack->scope == RPG::Skill::Scope_enemies)
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, Main_Data::game_enemyparty.get(), *attack));
+		else
+			actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Skill>(actor, Main_Data::game_enemyparty->GetRandomActiveBattler(), *attack));
+		return;
+	}
+
+	Game_Battler* target = Main_Data::game_enemyparty->GetRandomActiveBattler();
+	if (target)
+		actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::Normal>(actor, target));
+	else
+		actor->SetBattleAlgorithm(std::make_shared<Game_BattleAlgorithm::NoMove>(actor));
+}
