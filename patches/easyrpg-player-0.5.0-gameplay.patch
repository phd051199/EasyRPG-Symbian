+			const int animation_id = Data::actors[actor->GetId() - 1].unarmed_animation;
+			animation = animation_id > 0 && animation_id <= static_cast<int>(Data::animations.size()) ? &Data::animations[animation_id - 1] : NULL;
+		}
+	} else {
+		animation = Data::animations.empty() ? NULL : &Data::animations[0];
+	}
+}
