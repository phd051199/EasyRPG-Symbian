+		const RPG::Item* weapon = GetCurrentWeapon();
+		if (weapon && weapon->animation_id > 0 && weapon->animation_id <= static_cast<int>(Data::animations.size()))
+			animation = &Data::animations[weapon->animation_id - 1];
