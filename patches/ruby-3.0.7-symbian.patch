@@ -16,16 +16,16 @@
 .syntax unified
 
 PREFIXED_SYMBOL(SYMBOL_PREFIX,coroutine_transfer):
-	# Save caller state (8 registers + return address)
+	@ Save caller state (8 registers + return address)
 	push {r4-r11,lr}
 
-	# Save caller stack pointer
+	@ Save caller stack pointer
 	str sp, [r0]
 
-	# Restore callee stack pointer
+	@ Restore callee stack pointer
 	ldr sp, [r1]
 
-	# Restore callee state (8 registers program counter)
+	@ Restore callee state (8 registers program counter)
 	pop {r4-r11,pc}
 
